# Copie este arquivo para ".env" (mesma pasta) e preencha com sua chave.
# Nunca commite o arquivo .env de verdade — ele fica no .gitignore.

# Fornecedor de dados esportivos ativo. Hoje só existe "api-sports"
# (valor padrão, não precisa preencher) — ver server/src/providers/
# pra saber como plugar um 2º fornecedor (ex.: Sportmonks) sem mexer
# no resto do código. Trocar de fornecedor é só mudar essa variável +
# a credencial dele abaixo, nada mais.
# DATA_PROVIDER=api-sports

# Sua chave da API-Sports (dashboard.api-football.com ou api-sports.io)
# — só usada quando DATA_PROVIDER=api-sports (o padrão).
API_SPORTS_KEY=

# Controla o modo ao vivo/exemplo. Valores aceitos:
#   auto (padrão) — ao vivo se API_SPORTS_KEY estiver preenchida acima,
#                    exemplo se não estiver.
#   live           — força modo ao vivo; se a chave estiver faltando ou
#                    errada, os endpoints retornam erro explícito em vez
#                    de cair quieto pro modo exemplo (bom pra debugar
#                    configuração no Railway/host).
#   demo           — força modo exemplo mesmo com a chave configurada
#                    (não gasta cota da API; bom pra ambiente de teste).
APP_MODE=auto

# ID da liga do Brasileirão Série A na API-Sports.
# 71 é o valor mais comumente reportado, mas CONFIRME no seu plano:
# GET /api/leagues/search?name=Brazil  (rode o servidor e acesse essa rota)
LEAGUE_ID=71

# Multi-campeonato (Pro: Brasil/Inglaterra/Espanha; Enterprise: as
# mesmas 3 + histórico) — Premier League e La Liga já estão cadastradas
# no registro (server/src/competitions.js, ids 39 e 140 na API-Sports),
# mas começam DESABILITADAS pra dado real (Pro/Enterprise continua
# explorando as duas em modo exemplo enquanto isso). Depois de
# confirmar no seu painel da API-Sports que o plano contratado cobre
# essas ligas, habilite com uma lista separada por vírgula dos ids que
# quiser ligar (sem espaço, ou com espaço depois da vírgula, tanto faz)
# — não precisa editar código nem dar redeploy manual de código, só
# essa variável no Railway/host + reiniciar:
#   ENABLED_COMPETITIONS=premier_league,la_liga
# Só a Premier League:
#   ENABLED_COMPETITIONS=premier_league
# Deixe em branco (ou apague a variável) pra voltar as duas pro modo
# exemplo.
# ENABLED_COMPETITIONS=

# Histórico de temporadas anteriores (Enterprise, 3 temporadas antes da
# atual — ver LIVE_SEASON abaixo) — mesmo espírito do
# ENABLED_COMPETITIONS acima: confirme cobertura no seu plano da
# API-Sports (geralmente exige tier pago específico) antes de ativar.
#   ENABLE_HISTORY=true
# ENABLE_HISTORY=

# Temporada usada no modo ao vivo. O front-end pergunta esse valor pro
# backend (GET /api/health) — não precisa mais editar código pra trocar
# de temporada, só essa variável aqui (ou no painel do Railway/host) +
# reiniciar. Planos free da API-Sports costumam cobrir só temporadas
# passadas, não a corrente — por isso o padrão abaixo é 2023 e não o
# ano atual; ajuste conforme a cobertura do seu plano (confirme em
# GET /api/leagues/search?name=Brazil, campo "seasons").
LIVE_SEASON=2023

# Porta local do servidor
PORT=8787

# (Opcional) URL de um feed RSS (.xml/.rss) pra aba Notícias. Sem
# preencher, usa uma busca do Google Notícias por "Brasileirão"/
# "futebol brasileiro" (agrega vários veículos, gratuito, mas não
# documentado oficialmente pelo Google). Se quiser um veículo
# específico, cole aqui a URL do feed RSS dele.
# NEWS_RSS_URL=

# ---- Área "Apoie o BR Data" (planos Lite/Pro/Enterprise, pagamento
#      por cartão ou PIX via Mercado Pago) ----

# Access Token de PRODUÇÃO da sua aplicação no Mercado Pago (painel:
# mercadopago.com.br/developers/panel > sua aplicação > Credenciais de
# produção). Sem isso, o botão de pagamento fica indisponível — não
# afeta o resto do site (tabela, jogos etc.), que continua funcionando
# normal. Veja README-PAGAMENTOS.md.
MERCADOPAGO_ACCESS_TOKEN=

# (Opcional) Sobrescreve o preço de cada plano sem precisar editar
# server/src/supportPlans.js nem dar redeploy manual de código — só
# a variável no Railway/host + reiniciar. Sem preencher, usa os
# valores padrão (5.99 / 14.99 / 29.99).
# PLAN_LITE_PRICE=5.99
# PLAN_PRO_PRICE=14.99
# PLAN_ENTERPRISE_PRICE=29.99

# (Opcional) URL pública do site, tipo https://seuapp.up.railway.app —
# usada pra montar os links de volta e o webhook do Mercado Pago. Sem
# preencher, o servidor tenta descobrir sozinho a partir do próprio
# request (funciona bem no Railway). Só defina se a detecção automática
# vier errada (ex.: atrás de outro proxy/CDN/domínio customizado).
# PUBLIC_BASE_URL=

# (Opcional) Senha do endpoint de admin GET /api/admin/users, que lista
# os usuários cadastrados (sem senha) e a contagem de sessões ativas —
# uma forma de consultar o que está persistido no Volume sem precisar
# de acesso via terminal/CLI ao container. Sem preencher, o endpoint
# fica completamente desativado (404 sempre). Se preencher, use um
# valor longo e aleatório (ex.: openssl rand -hex 32) e NUNCA reutilize
# senha de outro lugar — configure só na variável de ambiente do
# Railway (HML/PRD podem ter valores diferentes), nunca aqui no .env
# comitado. Acesse com:
#   https://SEU-DOMINIO/api/admin/users?secret=SUA_SENHA
# ADMIN_SECRET=
