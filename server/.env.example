# Copie este arquivo para ".env" (mesma pasta) e preencha com sua chave.
# Nunca commite o arquivo .env de verdade — ele fica no .gitignore.

# Sua chave da API-Sports (dashboard.api-football.com ou api-sports.io)
API_SPORTS_KEY=

# ID da liga do Brasileirão Série A na API-Sports.
# 71 é o valor mais comumente reportado, mas CONFIRME no seu plano:
# GET /api/leagues/search?name=Brazil  (rode o servidor e acesse essa rota)
LEAGUE_ID=71

# Porta local do servidor
PORT=8787
