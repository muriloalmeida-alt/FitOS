# Serviço systemd — mantém o site rodando em segundo plano e reinicia
# sozinho se cair ou se o servidor reiniciar.
#
# Instalação (como root):
#   1) Ajuste WorkingDirectory e User abaixo para o seu caminho/usuário real
#   2) sudo cp brasileirao.service /etc/systemd/system/brasileirao.service
#   3) sudo systemctl daemon-reload
#   4) sudo systemctl enable --now brasileirao
#
# Comandos úteis depois:
#   sudo systemctl status brasileirao     # ver status
#   sudo systemctl restart brasileirao    # reiniciar (ex.: após git pull)
#   journalctl -u brasileirao -f          # ver logs em tempo real

[Unit]
Description=Brasileirao 2026 - Simulador (backend + site)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/brasileirao-2026-simulador/server
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
EnvironmentFile=/var/www/brasileirao-2026-simulador/server/.env

# Hardening básico (opcional, remova se causar problemas de permissão)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
