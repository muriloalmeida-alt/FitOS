# ── Servidor ──────────────────────────────────────────────────────────────
PORT=8787

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────
# Ver docs/WHATSAPP-SETUP.md para o passo a passo completo.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Token que você escolhe e cola no campo "Verify token" do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=troque-por-um-token-secreto
# App secret do app da Meta, usado para validar a assinatura (X-Hub-Signature-256)
# das requisições do webhook. Opcional em dev, recomendado em produção.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0

# ── IA — Claude (Anthropic) ──────────────────────────────────────────────
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── Transcrição de áudio (respostas faladas do candidato) ───────────────
# Claude ainda não processa áudio nativamente, então as respostas em áudio
# são transcritas antes de irem pra IA. Usamos a API Whisper da OpenAI por
# ser o serviço de STT mais simples de integrar — troque livremente em
# src/services/transcription.js por outro provedor (Deepgram, Google STT etc).
OPENAI_API_KEY=

# ── Perguntas em áudio (opcional, desligado por padrão) ──────────────────
# Se ligado (=true), além do texto o bot também envia a pergunta da
# entrevista como nota de voz (TTS via OpenAI). Requer OPENAI_API_KEY acima.
TTS_ENABLED=false
TTS_VOICE=alloy

# ── Banco de dados local (arquivo JSON) ──────────────────────────────────
# MVP usa um arquivo JSON como armazenamento — sem dependências nativas,
# fácil de rodar em qualquer lugar. Ver docs/ARCHITECTURE.md para o
# caminho de migração pra Postgres quando o volume justificar.
DATA_DIR=./data
